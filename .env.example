# Copy to .env (git-ignored). TESTNET ONLY. Never put a key here that has ever held real funds.

# Chain: 84532 = Base Sepolia (default), 11155111 = Ethereum Sepolia (fallback)
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org

# Pimlico bundler, used only for owner-side userOps (deploy account, revoke).
# Free key: https://dashboard.pimlico.io
PIMLICO_API_KEY=

# Throwaway test keys generated locally by `pnpm poc:keys` (Phase 1). Do not reuse anywhere.
POC_OWNER_PRIVATE_KEY=
POC_AGENT_PRIVATE_KEY=

# Phase 4 demo agent
ANTHROPIC_API_KEY=
