# Copy to .env (git-ignored). TESTNET ONLY. Never put a key here that has ever held real funds.

# Chain: 84532 = Base Sepolia (default), 11155111 = Ethereum Sepolia (fallback)
CHAIN_ID=84532

# NETWORK=fork  -> local anvil fork of Base Sepolia (no faucet needed; balances set via anvil_setBalance)
# NETWORK=live  -> real Base Sepolia (accounts need faucet ETH; gives explorer links)
NETWORK=fork
FORK_RPC_URL=http://127.0.0.1:8545
RPC_URL=https://sepolia.base.org

# ERC-4337 bundler, used only for owner-side userOps (deploy account, revoke).
# Pimlico's public endpoint needs no key (rate-limited). Set PIMLICO_API_KEY only if you hit limits.
BUNDLER_URL=https://public.pimlico.io/v2/84532/rpc
PIMLICO_API_KEY=

# Throwaway test keys generated locally by the PoC key script (Phase 1). Do not reuse anywhere.
POC_OWNER_PRIVATE_KEY=
POC_AGENT_PRIVATE_KEY=

# Phase 4 demo agent
ANTHROPIC_API_KEY=

# Phase 2: policy service + approver
POLICY_SERVICE_PORT=8787
POLICY_DB_PATH=policy-service.sqlite
APPROVER_ORIGIN=http://localhost:3000
# Live mode only: ERC-4337 bundler the browser sends passkey-signed userOps to
NEXT_PUBLIC_BUNDLER_URL=https://public.pimlico.io/v2/84532/rpc
