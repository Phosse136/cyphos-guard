{
  "name": "@cyphos-guard/approver",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname localhost --port 3000",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --hostname localhost --port 3000",
    "typecheck": "tsc -p tsconfig.json",
    "e2e:browser": "node --env-file-if-exists=../../.env e2e/browser.ts",
    "dev:all": "node --env-file-if-exists=../../.env scripts/dev.ts",
    "e2e:demo": "node --env-file-if-exists=../../.env e2e/demo.ts",
    "e2e:live": "node --env-file-if-exists=../../.env e2e/live.ts",
    "predev": "mkdir -p public && cp ../../site/theme.js public/theme.js",
    "prebuild": "mkdir -p public && cp ../../site/theme.js public/theme.js"
  },
  "dependencies": {
    "@metamask/smart-accounts-kit": "2.0.0",
    "@cyphos-guard/sdk": "workspace:*",
    "@cyphos-guard/shared": "workspace:*",
    "@simplewebauthn/browser": "^14.0.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "viem": "^2.58.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.3.5",
    "playwright-core": "1.65.1",
    "@cyphos-guard/policy-service": "workspace:*",
    "@hono/node-server": "^2.1.11",
    "@cyphos-guard/demo-agent": "workspace:*"
  }
}
