# cyphos-guard approver, public. Only port 443 is forwarded by the router, so certificates use TLS-ALPN-01.
guard.example.com {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy 127.0.0.1:3300
}

app.cyphosguard.com {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	# Public, anonymous usage statistics: static files written hourly by cyphos-guard-stats.timer.
	redir /stats /stats/ 308
	handle_path /stats/* {
		root * /var/lib/cyphos-guard-public/stats
		header Cache-Control "public, max-age=300"
		header X-Content-Type-Options nosniff
		file_server
	}
	handle {
		reverse_proxy 127.0.0.1:3301
	}
}
