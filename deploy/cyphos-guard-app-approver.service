[Unit]
Description=cyphos-guard approver web app (public at app.cyphosguard.com)
After=network-online.target cyphos-guard-app-policy.service
Wants=network-online.target

[Service]
User=cyphos
Group=cyphos
WorkingDirectory=/opt/cyphos-guard/apps/approver
EnvironmentFile=/etc/cyphos-guard/app.env
ExecStart=/opt/cyphos-guard/apps/approver/node_modules/.bin/next start --hostname 127.0.0.1 --port 3301
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/cyphos-guard/apps/approver/.next/cache
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
