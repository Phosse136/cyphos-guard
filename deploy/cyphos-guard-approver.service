[Unit]
Description=cyphos-guard approver web app (second instance, e.g. guard.example.com)
After=network-online.target cyphos-guard-policy.service
Wants=network-online.target

[Service]
User=cyphos
Group=cyphos
WorkingDirectory=/opt/cyphos-guard/apps/approver
EnvironmentFile=/etc/cyphos-guard/env
ExecStart=/opt/cyphos-guard/apps/approver/node_modules/.bin/next start --hostname 127.0.0.1 --port 3300
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/cyphos-guard/apps/approver/.next/cache
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

# Extra sandboxing (systemd-analyze security). No MemoryDenyWriteExecute: Node's JIT needs W^X exceptions.
PrivateDevices=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
