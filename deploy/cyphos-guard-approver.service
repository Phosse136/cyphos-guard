[Unit]
Description=cyphos-guard approver web app (public at guard.cyphos.de)
After=network-online.target cyphos-guard-policy.service
Wants=network-online.target

[Service]
User=cyphos
Group=cyphos
WorkingDirectory=/opt/cyphos-guard/apps/approver
EnvironmentFile=/etc/cyphos-guard/env
ExecStart=/opt/cyphos-guard/apps/approver/node_modules/.bin/next start --hostname 127.0.0.1 --port 3300
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/cyphos-guard/apps/approver/.next/cache
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
