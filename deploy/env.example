# cyphos-guard production (public, https://app.example.com). TESTNET ONLY (Base Sepolia).
NETWORK=live
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
BUNDLER_URL=https://public.pimlico.io/v2/84532/rpc
NEXT_PUBLIC_BUNDLER_URL=https://public.pimlico.io/v2/84532/rpc
APPROVER_ORIGIN=https://app.example.com
WEBAUTHN_RP_ID=app.example.com
POLICY_SERVICE_PORT=8887
POLICY_SERVICE_URL=http://127.0.0.1:8887
POLICY_DB_PATH=/var/lib/cyphos-guard/policy-service.sqlite
COSIGNER_PRIVATE_KEY=  # 0x + 64 hex, generate fresh for this server
OWNER_SETUP_CODE=  # random string; needed once to register the owner passkey
# Public instance for several owners (each sees only their own account). Off = single-owner (default).
# With OWNER_SETUP_CODE set as well, every registration needs it (an invite code).
# OPEN_REGISTRATION=1
# MAX_OWNERS=1000
NEXT_TELEMETRY_DISABLED=1
# The MetaMask Smart Accounts Kit sends usage analytics unless Do-Not-Track is set.
DO_NOT_TRACK=1
# Optional notifications (see deploy/README.md): TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID, DISCORD_WEBHOOK_URL, NTFY_URL
# NOTIFY_EVENTS=all
# NOTIFY_SUMMARY_HOUR=20
# Usage reports (deploy/README.md): stable pseudonyms across exports. Long random secret, e.g. openssl rand -hex 32.
# REPORT_SALT=
