{
  "name": "cyphos-guard",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "check-secrets": "bash scripts/check-secrets.sh --all",
    "poc": "pnpm --filter @cyphos-guard/poc poc",
    "poc:keys": "pnpm --filter @cyphos-guard/poc keys",
    "e2e": "pnpm --filter @cyphos-guard/poc e2e:escalation",
    "dev": "pnpm --filter @cyphos-guard/approver dev:all",
    "e2e:browser": "pnpm --filter @cyphos-guard/approver build && pnpm --filter @cyphos-guard/approver e2e:browser",
    "test:fork": "vitest run --config vitest.fork.config.ts",
    "demo:selftest": "pnpm --filter @cyphos-guard/demo-agent run demo-selftest --",
    "demo:setup": "pnpm --filter @cyphos-guard/demo-agent run demo-setup",
    "demo:agent": "pnpm --filter @cyphos-guard/demo-agent run demo-agent",
    "e2e:demo": "pnpm --filter @cyphos-guard/approver build && pnpm --filter @cyphos-guard/approver e2e:demo",
    "contracts:deploy": "pnpm --filter @cyphos-guard/poc run deploy-cosigner",
    "contracts:test": "pnpm --filter @cyphos-guard/contracts test",
    "contracts:build": "pnpm --filter @cyphos-guard/contracts build",
    "poc:cosigner": "pnpm --filter @cyphos-guard/poc run cosigner",
    "e2e:live": "pnpm --filter @cyphos-guard/approver build && pnpm --filter @cyphos-guard/approver e2e:live",
    "cli": "node packages/cli/src/cli.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
