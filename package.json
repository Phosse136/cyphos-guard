{
  "name": "phoswallet",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "check-secrets": "bash scripts/check-secrets.sh --all",
    "poc": "pnpm --filter @phoswallet/poc poc",
    "poc:keys": "pnpm --filter @phoswallet/poc keys",
    "e2e": "pnpm --filter @phoswallet/poc e2e:escalation",
    "dev": "pnpm --filter @phoswallet/approver dev:all",
    "e2e:browser": "pnpm --filter @phoswallet/approver build && pnpm --filter @phoswallet/approver e2e:browser",
    "test:fork": "vitest run --config vitest.fork.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
