# Security headers for cyphosguard.com (Apache, e.g. STRATO webspace). Upload next to index.html.
# The pages also carry the CSP as a <meta> tag, so they stay protected if mod_headers is unavailable.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  # Landing + legal pages: only the same-origin light/dark switch (theme.js), nothing else.
  Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; img-src 'self' data:; media-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
</IfModule>
# Compress text (the landing page is ~30 KB raw, ~8 KB compressed). Media is already compressed.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript text/javascript image/svg+xml
</IfModule>
# Caching. Pages always revalidate (ETag), so a fix to the site or the recovery page is seen at once. Scripts,
# styles, icons: one day (theme.js has no hash in its name). Video and poster: one week.
<IfModule mod_headers.c>
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(js|css|svg)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.(mp4|webm|webp|png)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
AddType image/webp .webp
# HTTPS only.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
